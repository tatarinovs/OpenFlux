<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CameraX Preview View -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dark Scrim & Cutout Overlay -->
    <com.openflux.client.ui.view.ScannerOverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_round_scanner_button"
            android:contentDescription="Закрыть"
            android:padding="11dp"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnTorch"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_round_scanner_button"
            android:contentDescription="Фонарик"
            android:padding="11dp"
            android:src="@drawable/ic_flashlight"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Header Instruction Prompt (Icon + Text) -->
    <LinearLayout
        android:id="@+id/promptContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/guidelineCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="QR"
            android:src="@drawable/ic_qr_code"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сканируйте QR-код"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Reference Guideline roughly matching cutout top -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.32" />

    <!-- Bottom Action Bar (Gallery button) -->
    <ImageButton
        android:id="@+id/btnGallery"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_round_scanner_button"
        android:contentDescription="Выбрать из галереи"
        android:padding="11dp"
        android:src="@drawable/ic_gallery"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="#FFFFFF" />

</androidx.constraintlayout.widget.ConstraintLayout>
